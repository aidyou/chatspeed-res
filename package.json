{
  "name": "chatspeed-res",
  "version": "1.0.0",
  "private": true,
  "description": "Search-friendly resource catalog for ChatSpeed MCP, model providers, and free AI services.",
  "type": "module",
  "scripts": {
    "dev": "python3 scripts/dev.py",
    "docs:dev": "pnpm dev",
    "build": "pnpm catalog:build && vuepress build docs",
    "docs:build": "pnpm build",
    "preview": "python3 -m http.server 8080 --directory docs/.vuepress/dist",
    "catalog:build": "python3 scripts/build-index.py",
    "catalog:check": "python3 scripts/build-index.py --check",
    "format:check": "python3 -m json.tool package.json >/dev/null"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "typescript": "^5.7.0",
    "vuepress": "2.0.0-rc.31",
    "vuepress-theme-hope": "2.0.0-rc.107"
  },
  "dependencies": {
    "vue": "^3.5.0"
  }
}
