---
import catalog from '../../data/generated/catalog.json'

export function getStaticPaths() {
  return catalog.items.map(item => ({
    params: { channel: item.channel, id: item.id },
    props: { item }
  }))
}

const { item } = Astro.props
const text = (values: Record<string, string>) => values.en || Object.values(values)[0] || ''
const title = text(item.name)
const description = text(item.description)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · ChatSpeed Resource Center</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={item.tags.join(', ')} />
  </head>
  <body>
    <main>
      <a href={`/${item.channel}/`}>← Back to {item.channel}</a>
      <h1>{title}</h1>
      <p>{description}</p>
      <p><a href={item.website} rel="external noopener" target="_blank">Official website</a></p>
      <dl>
        <dt>Categories</dt><dd>{item.categories.join(', ')}</dd>
        <dt>Last verified</dt><dd>{item.lastVerifiedAt}</dd>
        <dt>Status</dt><dd>{item.status}</dd>
      </dl>
    </main>
  </body>
</html>
<style>
  body { margin: 0; color: #182230; font-family: system-ui, sans-serif; }
  main { max-width: 800px; margin: 0 auto; padding: 3rem 1.25rem; }
  a { color: #1677ff; }
  dt { font-weight: 700; margin-top: 1rem; }
  dd { margin-left: 0; }
</style>
