---
import ResourceBrowser from '../../components/ResourceBrowser.vue'
import catalog from '../../data/generated/catalog.json'

export function getStaticPaths() {
  return catalog.channels.map(channel => ({ params: { channel }, props: { channel } }))
}

const { channel } = Astro.props
const items = catalog.items.filter(item => item.channel === channel)
const titles = { mcp: 'MCP', models: 'Model Providers', 'free-ai': 'Free AI' }
const title = titles[channel as keyof typeof titles] || channel
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · ChatSpeed Resource Center</title>
    <meta name="description" content={`Browse ${title} resources for ChatSpeed.`} />
  </head>
  <body>
    <main>
      <a href="/">← ChatSpeed Resource Center</a>
      <h1>{title}</h1>
      <ResourceBrowser items={items} client:load />
    </main>
  </body>
</html>
<style>
  body { margin: 0; color: #182230; font-family: system-ui, sans-serif; }
  main { max-width: 1100px; margin: 0 auto; padding: 3rem 1.25rem; }
  a { color: #1677ff; }
</style>
